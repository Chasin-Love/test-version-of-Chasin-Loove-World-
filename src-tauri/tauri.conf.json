{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MY UNIVERSE",
  "version": "2.0.0",
  "identifier": "com.chasinlove.myuniverse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MY UNIVERSE",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/32x32.png"],
    "category": "Education",
    "shortDescription": "A living 3D cosmos of memories",
    "longDescription": "MY UNIVERSE — attention is gravity. Planets are memories, the black hole holds your encrypted vault, and a C++ simulation core drives the physics."
  }
}
